name: Build Static ARM64

on:
  workflow_dispatch:

jobs:
  build-arm64-static:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          submodules: recursive  # 关键：拉取 mavlink 子模块

      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y meson ninja-build pkg-config

      - name: Install aarch64 musl toolchain
        run: |
          # 下载预编译的 musl 交叉工具链
          wget https://musl.cc/aarch64-linux-musl-cross.tgz
          tar xzf aarch64-linux-musl-cross.tgz
          sudo mv aarch64-linux-musl-cross /opt/
          echo "/opt/aarch64-linux-musl-cross/bin" >> $GITHUB_PATH

      - name: Create cross file
        run: |
          cat > cross-aarch64-musl.ini << 'EOF'
          [binaries]
          c = 'aarch64-linux-musl-gcc'
          cpp = 'aarch64-linux-musl-g++'
          ar = 'aarch64-linux-musl-ar'
          strip = 'aarch64-linux-musl-strip'
          pkgconfig = 'pkg-config'

          [host_machine]
          system = 'linux'
          cpu_family = 'aarch64'
          cpu = 'aarch64'
          endian = 'little'

          [properties]
          c_args = ['-static']
          cpp_args = ['-static']
          c_link_args = ['-static']
          cpp_link_args = ['-static']
          EOF

      - name: Patch meson.build for static linking
        run: |
          # 使用 sed 或 patch 添加 -static-libstdc++ 和 -static-libgcc
          sed -i "s/install: true,/install: true,\n        link_args: ['-static-libstdc++', '-static-libgcc', '-static'],/" src/meson.build

      - name: Configure meson
        run: |
          meson setup build \
            --cross-file cross-aarch64-musl.ini \
            --buildtype=release \
            -Dsystemdsystemunitdir=''

      - name: Build
        run: ninja -C build

      - name: Verify static binary
        run: |
          file build/src/mavlink-routerd
          ldd build/src/mavlink-routerd || true  # musl 静态链接应显示不是动态可执行文件

      - name: Strip binary
        run: aarch64-linux-musl-strip build/src/mavlink-routerd

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: mavlink-routerd-arm64-static
          path: build/src/mavlink-routerd

      - name: Release
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v1
        with:
          files: build/src/mavlink-routerd
